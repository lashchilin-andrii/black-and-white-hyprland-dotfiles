// -*- mode: jsonc -*-
{
    "include": [
        "~/.config/waybar/modules/left/workspaces.json",

        "~/.config/waybar/modules/center/clock.json",

        "~/.config/waybar/modules/right/custom-language.json",
        "~/.config/waybar/modules/right/pulseaudio.json",
        "~/.config/waybar/modules/right/power-profiles-daemon.json",
        "~/.config/waybar/modules/right/battery.json",
        "~/.config/waybar/modules/right/tray.json"
    ],

    "spacing": 10,
    "margin-left": 15,
    "margin-right": 15,
    "margin-top": 10,
    "margin-bottom": 0,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/language",
        "pulseaudio",
        "power-profiles-daemon",
        "battery",
        "tray"
    ]
}