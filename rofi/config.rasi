configuration {
    /* List of enabled modes */
    modi: "run,drun";
    font: "Noto Sans Mono Bold 21";
    /* Enable application icons */
    terminal: "kitty";
    /* Format for drun mode (App Name) */
    drun-display-format: "{name}";
    /* Position of window (0 is center) */
    location: 0;
    /* Keep command history */
    disable-history: false;
    /* Hide the vertical scrollbar */
    hide-scrollbar: true;
    
    /* Disable the mode switcher */
    sidebar-mode: false;
}

/* Load the color variables from the theme */
@theme "colors"

/* 1. window */
window {
    border: 1px;
    border-color: @border-col;
    border-radius: 8px;
    background-color: @bg-col;
    width: 30%;
}

/* 2. mainbox */
mainbox {
    background-color: transparent;
    padding: 10px;
}

/* 3. inputbar */
inputbar {
    children: [prompt, entry];
    background-color: transparent;
}

/* 4. prompt */
prompt {
    enabled: false;
}

/* 5. entry */
entry {
    padding: 10px 10px;
    text-color: @fg-col;
    background-color: transparent;
    placeholder: "Search...";
}

/* 6. listview */
listview {
    lines: 1;
    columns: 1;
    background-color: transparent;
}

/* 7. element */
element {
    padding: 10px 10px;
    background-color: transparent;
    text-color: @fg-col;
}

/* Styling for the currently selected item container */
element selected {
    background-color: @selected-col;
    border-radius: 2px;
    text-color: @fg-col2;
}

/* 8. element-icon */
element-icon {
    enabled: false;
    background-color: transparent;
    text-color: inherit;
}

/* 9. element-text */
element-text {
    background-color: transparent;
    text-color: inherit;
}

/* Force text element inside selection to remain completely transparent */
element selected element-text {
    background-color: transparent;
    text-color: @fg-col2;
}

/* 10. textbox (and error-message container) */
textbox {
    text-color: @fg-col;
    background-color: transparent;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

/* Error message container window */
error-message {
    background-color: @bg-col;
    padding: 50px; 
    margin: 0px;
}